.program t425_link_rx

; RX fisico do Link IMS T425.
;
; DATA:
;   START = 1
;   TYPE  = 1
;   D0..D7
;   STOP  = 0
;
; ACK:
;   START = 1
;   TYPE  = 0
;
; Temporizacao:
;   Link = 10 Mbit/s
;   bit  = 100 ns
;   SM   = 20 MHz
;   ciclo = 50 ns
;
; IMPORTANTE:
;
; A instrucao WAIT detecta o inicio do START.
; O primeiro IN ocorre imediatamente depois do WAIT.
; Assim a primeira amostra fica no primeiro ciclo de 50 ns.
;
; Os bits seguintes usam:
;
;   NOP + IN = 2 ciclos = 100 ns
;
; Portanto:
;
;   START : IN
;   TYPE  : NOP + IN
;   D0    : NOP + IN
;   D1    : NOP + IN
;   D2    : NOP + IN
;   D3    : NOP + IN
;   D4    : NOP + IN
;   D5    : NOP + IN
;   D6    : NOP + IN
;   D7    : NOP + IN
;   STOP  : NOP + IN
;
; Total: 11 amostras, uma por bit.
;
; O PIO apenas coleta a palavra.
; A classificacao DATA/ACK permanece no adapter.

.wrap_target

rx_start:

    mov isr, null
    set x, 8

    wait 1 pin 0
    in pins, 1

    nop
    nop
    in pins, 1

    jmp pin, rx_data_event
    jmp rx_data_continue

rx_data_event:

    irq nowait 0 rel

rx_data_continue:

    in pins, 1

rx_data_loop:

    nop
    in pins, 1
    jmp x-- rx_data_loop

    push block

    mov isr, null
    jmp rx_start

.wrap
